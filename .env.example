# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------
# Pooled URL — used by the app at runtime.
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/superdesk?sslmode=require"
# Unpooled URL — used by `prisma migrate` only.
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/superdesk?sslmode=require"

# ---------------------------------------------------------------------------
# Redis (Upstash) — Socket.IO pub/sub adapter, BullMQ queues, rate limiting
# ---------------------------------------------------------------------------
REDIS_URL="rediss://default:pass@host.upstash.io:6379"

# ---------------------------------------------------------------------------
# Auth & crypto
# ---------------------------------------------------------------------------
# openssl rand -base64 48
AUTH_SECRET="change-me-32-bytes-minimum"
# Signs short-lived widget visitor tokens. Separate key so a leak of one does
# not grant agent sessions.
WIDGET_TOKEN_SECRET="change-me-too"
# Shared secret the gateway uses to call back into the web API.
GATEWAY_INTERNAL_SECRET="change-me-three"

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4000"
GATEWAY_PORT="4000"
# Apex domain that workspace KB subdomains hang off: <slug>.help.example.com
KB_BASE_DOMAIN="help.example.com"

# ---------------------------------------------------------------------------
# AI (Anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-5"
# Hard ceiling per workspace per hour; protects against a runaway loop.
AI_SUMMARY_HOURLY_LIMIT="60"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# resend | mailgun | console  (console = log to stdout, for local dev)
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_SIGNING_KEY=""
# Domain replies are sent from, and Message-IDs are minted under.
OUTBOUND_EMAIL_DOMAIN="example.com"
# Domain that receives support mail: <workspace-alias>@<this>
INBOUND_EMAIL_DOMAIN="inbound.example.com"
# Verifies the inbound webhook actually came from the provider.
INBOUND_WEBHOOK_SECRET="change-me-four"

# ---------------------------------------------------------------------------
# Custom domains (Vercel Domains API)
# ---------------------------------------------------------------------------
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
