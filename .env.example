# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------
# Pooled URL — used by the app at runtime.
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/superdesk?sslmode=require"
# Unpooled URL — used by `prisma migrate`/`db push` and anything needing a
# session-level connection.
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/superdesk?sslmode=require"

# ---------------------------------------------------------------------------
# Redis (Upstash)
# ---------------------------------------------------------------------------
# TCP connection string. Not used by anything in the current deployment
# (realtime ships as Server-Sent Events served directly from the Next.js
# app — see apps/web/src/lib/sse.ts) — reserved for a future queue-backed
# worker. Required by env validation regardless; any reachable Redis works.
REDIS_URL="rediss://default:pass@host.upstash.io:6379"
# REST credentials — these are what's actually used, for rate limiting
# (apps/web/src/lib/ratelimit.ts). Falls back to an in-process store if unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Auth & crypto
# ---------------------------------------------------------------------------
# openssl rand -base64 48
AUTH_SECRET="change-me-32-bytes-minimum"
# Signs short-lived widget visitor tokens. Separate key so a leak of one does
# not grant agent sessions.
WIDGET_TOKEN_SECRET="change-me-too"
# Currently unused (reserved) — see REDIS_URL above.
GATEWAY_INTERNAL_SECRET="change-me-three"

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Base domain the public knowledge base defaults to before a workspace
# connects a custom domain (Req 7). The KB itself is served path-based at
# /help/<workspace-slug>, not as a subdomain — this value is informational
# and shown in a couple of places, not used for routing.
KB_BASE_DOMAIN="help.example.com"

# ---------------------------------------------------------------------------
# AI (Anthropic)
# ---------------------------------------------------------------------------
# Leave unset to run with the AI summary panel in its degraded/extractive
# fallback mode (see apps/web/src/lib/ai/summarize.ts) — no code path breaks
# without it, the summaries are just heuristic instead of model-generated.
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-5"
# Hard ceiling per workspace per hour; protects against a runaway loop.
AI_SUMMARY_HOURLY_LIMIT="60"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# resend | mailgun | console  (console = log to stdout, for local dev — the
# default, and what this deployment actually runs with)
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_SIGNING_KEY=""
# Domain replies are sent from, and Message-IDs are minted under.
OUTBOUND_EMAIL_DOMAIN="example.com"
# Domain that receives support mail: <workspace-inbound-alias>@<this>
INBOUND_EMAIL_DOMAIN="example.com"
# Shared secret in the inbound webhook's query string — see
# apps/web/src/app/api/webhooks/email/inbound/route.ts for why a
# provider-specific request signature isn't used instead.
INBOUND_WEBHOOK_SECRET="change-me-four"

# ---------------------------------------------------------------------------
# Custom domains (Vercel Domains API) — Req 7
# ---------------------------------------------------------------------------
# Leave all three unset to run the feature in explain-only mode (the UI
# renders, but no live Vercel calls are made). A token here needs API access
# to the Vercel project these are deployed to — see the security note in
# README.md before reusing a broadly-scoped token.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
